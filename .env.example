# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI (Primary AI provider - GPT-4.1 for text, DALL-E 3 for images)
OPENAI_API_KEY=your_openai_api_key

# Anthropic (Fallback AI provider - Claude Opus 4.6 for text generation)
# If OpenAI fails or is unavailable, the system automatically falls back to Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# 🍌 Nano Banana 2 (Gemini 3.1 Flash Image) - MANDATORY for AI image generation
# Get your API key at: https://aistudio.google.com/app/apikey
# IMAGE PRIORITY ORDER: 1. Nano Banana 2 → 2. Unsplash (NO DALL-E)
#
# ✅ SIMPLE SETUP - Just add your API key below!
# Uses Nano Banana 2 (gemini-3.1-flash-image-preview) - LATEST MODEL!
# Launched Feb 26, 2026 - Pro-level quality at Flash speed
# NO Vertex AI needed - works with simple API key from AI Studio
#
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key
#
# 🍌 Nano Banana 2 Benefits (Latest Model - Launched 2 days ago!):
# - ✅ SUPERIOR image quality (far better than DALL-E or Imagen 3)
# - ✅ Ultra-fast generation (2-4 seconds) - 40% faster than Pro
# - ✅ Pro-level quality at Flash speed - best of both worlds
# - ✅ Simple API key setup (no Google Cloud project needed)
# - ✅ 2K/4K high-definition image support
# - ✅ Comprehensive prohibitions (NO cameras, NO logos, NO text)
# - ✅ Reads and uses COMPLETE business context
# - ✅ World-class, on-point, highly relevant images
# - ✅ Free tier: 1,500 requests/day
# - ✅ Up to 40% lower API cost vs Nano Banana Pro
#
# Model: gemini-3.1-flash-image-preview (Nano Banana 2)
# Alternative: gemini-3-pro-image-preview (Nano Banana Pro - highest quality 4K)

# Unsplash (PRIMARY IMAGE SOURCE - RECOMMENDED)
# Get your free API key at: https://unsplash.com/developers
# Free tier: 50 requests/hour (1,200/day)
# STRICT RULE: If NO Gemini configured, Unsplash is used (NOT DALL-E)
# Professional stock photography - instant, high quality
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Stripe Price IDs (get these from your Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PRICE_STARTER_MONTHLY=price_xxxxxx
NEXT_PUBLIC_STRIPE_PRICE_STARTER_ANNUAL=price_xxxxxx
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_xxxxxx
NEXT_PUBLIC_STRIPE_PRICE_PRO_ANNUAL=price_xxxxxx
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxxxxx
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE_ANNUAL=price_xxxxxx

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Subdomain API (airostudio server)
# This is the primary method for creating subdomains on webese.ai
SUBDOMAIN_API_URL=https://server.airostudio.io/smb/web/add-subdomain
SUBDOMAIN_API_KEY=your_subdomain_api_key
SUBDOMAIN_PARENT_DOMAIN=webese.ai

# Optional: Override delete/check endpoints if different from default
# SUBDOMAIN_API_DELETE_URL=https://server.airostudio.io/smb/web/delete-subdomain
# SUBDOMAIN_API_CHECK_URL=https://server.airostudio.io/smb/web/check-subdomain
