# ============================================
# WEBSITE PUBLISHING CONFIGURATION
# ============================================
# PRIORITY ORDER:
# 1. Subdomain API (airostudio server) - RECOMMENDED
# 2. Cloudflare R2 (for file hosting)
# 3. FTP Deployment (legacy)
# 4. Plesk API (complex)

# ============================================
# OPTION 0: SUBDOMAIN API (RECOMMENDED)
# ============================================
# Primary method for creating subdomains on webese.ai
# This is the recommended and simplest setup

SUBDOMAIN_API_URL=https://server.airostudio.io/smb/web/add-subdomain
SUBDOMAIN_API_KEY=your_subdomain_api_key
SUBDOMAIN_PARENT_DOMAIN=webese.ai

# ============================================
# PLESK PUBLISHING CONFIGURATION (FALLBACK)
# ============================================
# Choose ONE of these two options if not using Subdomain API:

# ============================================
# OPTION 1: FTP DEPLOYMENT (RECOMMENDED if no API Keys)
# ============================================
# Use this if "API Keys" option is missing in your Plesk
# Works with ALL Plesk versions

# FTP server (usually ftp.yourdomain.com or server IP)
FTP_HOST=ftp.webese.ai

# FTP username (created in Plesk → Domains → FTP Access)
FTP_USER=webese_publisher@webese.ai

# FTP password (set when creating FTP account)
FTP_PASSWORD=your-ftp-password-here

# FTP port (21 for FTP, 22 for SFTP)
FTP_PORT=21

# Use FTPS (secure FTP)
FTP_SECURE=false

# Remote path where files will be uploaded
FTP_REMOTE_PATH=/httpdocs

# Parent domain (for reference)
PLESK_PARENT_DOMAIN=webese.ai

# ============================================
# OPTION 2: PLESK API (Only if you have API Keys option)
# ============================================
# Use this ONLY if you have "API Keys" in Plesk Tools & Settings

# Your Plesk server hostname (without https://)
PLESK_HOST=your-plesk-server.com

# Plesk API Key (get from Tools & Settings → API Keys in Plesk)
PLESK_API_KEY=your-api-key-here

# Parent domain for creating subdomains (must exist in Plesk)
PLESK_PARENT_DOMAIN=webese.ai

# Optional: Plesk port (default: 8443)
PLESK_PORT=8443

# Optional: Use HTTPS (default: true)
PLESK_USE_HTTPS=true

# ============================================
# HOW TO SET UP FTP (OPTION 1)
# ============================================
# 1. Log in to Plesk
# 2. Go to: Domains → Select your domain → FTP Access
# 3. Click "Add FTP Account"
# 4. Fill in:
#    - FTP Account Name: webese_publisher
#    - Home Directory: /httpdocs
#    - Password: [create strong password]
# 5. Click OK
# 6. Use those credentials above
# 7. See FTP_SETUP.md for detailed instructions

# ============================================
# HOW TO GET API KEY (OPTION 2)
# ============================================
# 1. Log in to your Plesk control panel
# 2. Navigate to: Tools & Settings → API Keys
# 3. Click "Create API Key"
# 4. Name it: "Webese AI Website Publisher"
# 5. Copy the generated key to PLESK_API_KEY above
#
# If "API Keys" option is missing, use OPTION 1 (FTP) instead
